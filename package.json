{
  "name": "@proophboard/spec-modeling",
  "version": "0.2.0",
  "description": "Spec Modeling skeleton for AI agents.",
  "keywords": [
    "prooph-board",
    "spec-modeling",
    "cli",
    "realtime",
    "ai-agents",
    "spec-driven-development"
  ],
  "homepage": "https://github.com/proophboard/spec-modeling#readme",
  "bugs": {
    "url": "https://github.com/proophboard/spec-modeling/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proophboard/spec-modeling.git"
  },
  "license": "MIT",
  "author": "prooph software GmbH",
  "type": "module",
  "bin": {
    "spec-modeling": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "model",
    "AGENTS.md",
    "proophboard.spec-stream.json",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "dependencies": {
    "degit": "^2.8.4"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "model:sync": "npx @proophboard/spec-stream",
    "model:sync-back": "npx @proophboard/spec-stream sync-back",
    "model:validate": "npx @proophboard/spec-stream model validate",
    "model:typecheck": "npx @proophboard/spec-stream scenario typecheck",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/degit": "^2.8.6",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
